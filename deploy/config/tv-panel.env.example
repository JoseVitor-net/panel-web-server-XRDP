# /etc/tv-panel/tv-panel.env
# Arquivo de configuração de exemplo (sem segredos embutidos)

TV_PANEL_ENV_MODE=production
TV_PANEL_DB_PATH=/var/lib/tv-panel/tv_panel.db
TV_PANEL_SESSION_COOKIE=tv_panel_session
TV_PANEL_SESSION_TTL_MINUTES=480
TV_PANEL_COOKIE_SECURE=true
TV_PANEL_COOKIE_SAMESITE=strict
TV_PANEL_MAX_FAILED_LOGINS=5
TV_PANEL_LOCKOUT_MINUTES=15
TV_PANEL_GUACD_HOST=127.0.0.1
TV_PANEL_GUACD_PORT=4822
TV_PANEL_SYSTEMD_MODE=system-template
TV_PANEL_ALLOWED_ORIGINS=https://painel-tv.seudominio.interno

