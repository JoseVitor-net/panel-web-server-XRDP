# /etc/caddy/Caddyfile
# Reverse Proxy HTTPS com Caddy para o Painel de TVs e túnel WebSocket Guacamole.
# Para rede interna sem domínio público, "tls internal" emite certificado da CA local do Caddy.

:443 {
    tls internal {
        on_demand
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Encaminha API e túnel WebSocket (/api/ws/tv/*) para o backend FastAPI em 127.0.0.1:8000
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # Serve os arquivos estáticos compilados do frontend React/TypeScript
    handle {
        root * /opt/tv-panel/frontend/dist
        try_files {path} /index.html
        file_server
    }
}

